   color .2 .85 1 1
  }
  TextWidgetClass ThirdPartySubtitle {
   ignorepointer 1
   position .2 .22
   size .6 .06
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Normal_SDF
   font "gui/fonts/sdf_MetronBook72"
   "exact text" 1
   "text halign" center
   text "Different layout, different widget names"
