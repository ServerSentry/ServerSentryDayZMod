FrameWidgetClass DeathReportProbe {
 ignorepointer 1
 size 1 1
 hexactsize 0
 vexactsize 0
 {
  ButtonWidgetClass ReportProbeButton {
   position .28 .7
   size .44 .08
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Empty
   {
    FrameWidgetClass ReportProbeFill {
     ignorepointer 1
     size 1 1
     hexactsize 0
     vexactsize 0
    }
    TextWidgetClass ReportProbeLabel {
     ignorepointer 1
     size 1 1
     hexactsize 0
     vexactsize 0
     style Normal_SDF
     font "gui/fonts/sdf_MetronBook72"
     "exact text" 1
     text "Report suspicious death"
     "text halign" center
     "text valign" center
     color .9 .97 1 1
    }
   }
  }
  TextWidgetClass ProbeStatus {
   ignorepointer 1
   position .1 .82
   size .8 .06
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Normal_SDF
   font "gui/fonts/sdf_MetronBook72"
   "exact text" 1
   "text halign" center
   text "Local compatibility test - no report will be sent"
   color .6 .7 .8 1
  }
 }
}
