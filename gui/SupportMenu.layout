FrameWidgetClass rootFrame {
 size 0.35 0.467
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Main {
   ignorepointer 1
   position 0 0.002
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_black
   {
    PanelWidgetClass Header {
     ignorepointer 1
     position 0 0
     size 1 0.089
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style rover_sim_black
     {
      ButtonWidgetClass CloseBtn {
       color 0.502 0 0 1
       position 0.015 0.047
       size 0.043 0.684
       halign right_ref
       valign center_ref
