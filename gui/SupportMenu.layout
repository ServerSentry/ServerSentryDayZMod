       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Colorable
       text "X"
       font "gui/fonts/metron22"
      }
      TextWidgetClass HeaderLbl {
       ignorepointer 1
       position 0.09 0.04
       size 0.787 0.8
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "SUPPORT MENU "
       font "gui/fonts/amorserifpro28"
       "size to text h" 1
       "size to text v" 1
       "text halign" center
       "text valign" center
      }
      ImageWidgetClass Logo {
       ignorepointer 1
       position 0.02 0
       size 0.055 0.766
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       imageTexture "{B9718DA855602A9D}ServerSentryDayZMod/gui/ServerSentryLogo.edds"
       mode blend
       "src alpha" 1
       "clamp mode" invalid
       "stretch mode" stretch_w_h
      }
     }
    }
    PanelWidgetClass Outline {
     ignorepointer 1
     color 0.157 0.624 0.624 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Outline
    }
    TextWidgetClass PlayerName {
     ignorepointer 1
     position 0 0.13
     size 0.947 0.102
     halign center_ref
